# Production Environment Configuration
# Copy this file to .env for production deployment (Cloudflare Pages)
# NEVER commit .env to git - it's in .gitignore

# Supabase Configuration
# Get these values from your Supabase project dashboard:
# 1. Go to https://supabase.com/dashboard
# 2. Select your project
# 3. Navigate to Settings > API
# 4. Copy the Project URL and anon/public key
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Environment
NODE_ENV=production

# Logging Configuration
# Log levels: debug, info, warn, error
VITE_LOG_LEVEL=info

# Enable/disable metrics collection (disabled for now - see GitHub issue for proper implementation)
VITE_ENABLE_METRICS=false

# Prometheus integration for Grafana (disabled - need to implement scrape endpoint instead of push)
# VITE_METRICS_ENDPOINT=https://pushgateway.example.com/metrics/job/ms-tracker
# VITE_METRICS_FLUSH_INTERVAL=30000
# VITE_METRICS_BATCH_SIZE=100

# Log sampling (0.0-1.0) for high-volume scenarios
VITE_LOG_SAMPLING_RATE=1.0

# Buffer and flush settings
VITE_LOG_BUFFER_SIZE=200
VITE_LOG_FLUSH_INTERVAL=30000

# Privacy settings for healthcare data
VITE_HASH_USER_IDS=true
VITE_MAX_LOG_MESSAGE_LENGTH=1000
VITE_REDACTED_LOG_FIELDS=password,token,key,secret,auth,email

# Stack trace in logs (development: true, production: false)
VITE_ENABLE_STACK_TRACE=false

# Health monitoring
VITE_HEALTH_CHECK_ENABLED=true
VITE_HEALTH_CHECK_ENDPOINT=/health
VITE_HEALTH_CHECK_INTERVAL=30000
VITE_HEALTH_CHECK_TIMEOUT=5000

# Emergency logging controls
# VITE_DISABLE_LOGGING=false  # Uncomment to disable all logging