# Local Development Environment
# Copy this to .env.local for local development (overrides .env, gitignored).
# Uses the local Supabase instance started with `supabase start`.
#
# Local ports for this checkout are shifted +100 from Supabase defaults so this
# stack can run side-by-side with the `logbook` fork (which uses 54321 etc.).
# See supabase/config.toml.

# Local Supabase Configuration
PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Environment
NODE_ENV=development

# Show the "Sign up" link on the sign-in screen (hidden by default).
# VITE_ENABLE_SIGNUP=true
